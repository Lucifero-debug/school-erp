# Copy to .env and fill in. .env is gitignored.
#
# IMPORTANT: use .env, NOT .env.local.
# The Prisma CLI only reads .env. Next.js reads both, so .env works for
# everything. Using .env.local means every Prisma command fails with
# "Environment variable not found: DATABASE_URL".

# --- required ---------------------------------------------------

# Postgres. Neon (neon.tech) or Supabase (supabase.com), free to start.
# Prisma needs the DIRECT connection string for migrations, not the
# pooled one. On Neon that is the URL WITHOUT "-pooler" in the host.
DATABASE_URL="postgresql://neondb_owner:npg_QgT7ejsNEkt2@ep-autumn-haze-b5u62rf3-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Signs the session cookie. At least 32 random characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this signs everyone out.
SESSION_SECRET=""

# --- optional: parent messaging ---------------------------------
# Fee reminders and absence alerts over WhatsApp Cloud API. Without
# these the app still lists who would be messaged but cannot send.
# The template must be approved in Meta Business Manager first.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_FEE_TEMPLATE=fee_reminder
# WHATSAPP_ABSENCE_TEMPLATE=absence_alert
# WHATSAPP_TEMPLATE_LANG=en
